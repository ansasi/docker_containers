    {
      "id": 13,
      "type": "timeseries",
      "title": "Host temperature",
      "description": "Highest reported CPU hwmon sensor, falling back to thermal zones. proxmox1: orange at 90 °C, red at 98 °C; dns1/rpi4: orange at 70 °C, red at 75 °C. Colours are immediate; Minisforum alerts wait 10/2 minutes and only use k10temp. VMs normally have no physical sensor; QNAP is not scraped yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 35
