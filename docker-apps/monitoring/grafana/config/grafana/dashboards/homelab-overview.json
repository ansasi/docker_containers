    {
      "id": 10,
      "type": "table",
      "title": "Proxmox guests",
      "description": "Every VM and container (no templates). Newest backup: age of the newest PBS snapshot; \"none\" means PBS has no snapshot of it. Details in the Proxmox and PBS web interfaces (links at the top).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (id, vmid, name, type) (label_replace(pve_guest_info{template!=\"1\"}, \"vmid\", \"$1\", \"id\", \".+/([0-9]+)\"))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (id) (pve_up{id=~\"qemu/.+|lxc/.+\"}) - on (id) ((1 - max by (id) (pve_up{id=~\"qemu/.+|lxc/.+\"})) * on (id) max by (id) (pve_onboot_status))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "max by (id) (pve_onboot_status)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "max by (id) ((time() - max by (vm_id) (pbs_snapshot_vm_last_timestamp)) * on (vm_id) group_left (id) label_replace(pve_guest_info{template!=\"1\"}, \"vm_id\", \"$1\", \"id\", \".+/([0-9]+)\"))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "any",
            "filters": [
              {
                "fieldName": "name",
                "config": {
                  "id": "isNull",
                  "options": {}
                }
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true,
              "id": true
            },
            "indexByName": {
              "name": 0,
              "vmid": 1,
              "type": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Guest"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "vmid"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "ID"
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "type"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Type"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "qemu": {
                        "text": "VM",
                        "index": 0
                      },
                      "lxc": {
                        "text": "container",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "State"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "running",
                        "index": 0,
